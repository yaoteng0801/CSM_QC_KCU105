# ---------------------------------------------------------------------------------------------- #
# Output products (no -force: IPs that are already generated and synthesized are left alone, so a
# re-run is fast; delete ip_minidaq/<ip>/ to force one IP to be rebuilt).
# ---------------------------------------------------------------------------------------------- #
if {$ip_cfg_errors != 0} { error "$ip_cfg_errors IP parameter(s) were rejected -- see ERROR lines above" }
foreach ip [get_ips] {
    generate_target {instantiation_template synthesis simulation} $ip
}

# Out-of-context pre-synthesis: project-mode synth_design (tcl/build_full.tcl) reads each IP from its
# synthesis checkpoint, so without this the IP modules are 'not found'.
foreach ip [get_ips] {
    if {![file exists [get_property IP_OUTPUT_DIR $ip]/[get_property NAME $ip].dcp]} {
        puts "synth_ip [get_property NAME $ip] ..."
        synth_ip $ip
    }
}
puts "Generated [llength [get_ips]] IP cores for [get_property part [current_project]]"

